<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>수업 시간표</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <a href="/">소개</a> |
    <a href="/foods">좋아하는 음식</a> |
    <a href="/timetable">수업 시간표</a>
    | <a href="/gugudan_2">구구단</a>
  </nav>

  <h2>수업 시간표</h2>

  <% if (timetable.length === 0) { %>
    <p>등록된 수업이 없습니다.</p>
  <% } else { %>
    <table>
      <tr>
        <th>과목</th>
        <th>요일</th>
        <th>시간</th>
      </tr>
      <% for (let item of timetable) { %>
        <tr>
          <td><%= item.subject %></td>
          <td><%= item.day %></td>
          <td><%= item.time %></td>
        </tr>
      <% } %>
    </table>
  <% } %>
</body>
</html>
