<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>좋아하는 음식</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <a href="/">소개</a> |
    <a href="/foods">좋아하는 음식</a> |
    <a href="/timetable">수업 시간표</a>
    | <a href="/gugudan_2">구구단</a>
  </nav>

  <h2>좋아하는 음식</h2>

  <% if (foods.length === 0) { %>
    <p>등록된 음식이 없습니다.</p>
  <% } else { %>
    <div class="food-list">
      <% for (let food of foods) { %>
        <div class="card food-card">
          <% if (food.img) { %>
            <img src="<%= food.img %>" alt="<%= food.name %>">
          <% } else { %>
            <div class="no-img">사진 준비 중</div>
          <% } %>
          <h3><%= food.name %></h3>
          <p><%= food.desc %></p>
        </div>
      <% } %>
    </div>
  <% } %>
</body>
</html>
